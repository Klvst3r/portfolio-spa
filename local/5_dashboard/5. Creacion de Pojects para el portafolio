const getIcon = (iconName) => {
    // Si iconName es "Briefcase", busca "BriefcaseIcon" en el objeto SolidIcons
    const name = `${iconName}Icon`;
    return SolidIcons[name] || SolidIcons.QuestionMarkCircleIcon; // Icono por defecto si falla
};

